# Base de datos - Para Vercel usa una BD remota (como Clever Cloud, PlanetScale, etc.)
DB_HOST=your_remote_db_host
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

# Entorno
NODE_ENV=production
PORT=3000

# Para desarrollo local, copia este archivo a .env y llena con tus valores locales
