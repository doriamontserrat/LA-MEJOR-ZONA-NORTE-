# Base de datos remota (Clever Cloud, PlanetScale, etc.)
# Puedes usar DB_* o directamente las variables MYSQL_ADDON_* que entrega Clever Cloud:
#   MYSQL_ADDON_HOST, MYSQL_ADDON_PORT, MYSQL_ADDON_USER, MYSQL_ADDON_PASSWORD, MYSQL_ADDON_DB
# En Vercel se configuran en Project > Settings > Environment Variables (nunca en el repo).
DB_HOST=your_remote_db_host
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
# Conexiones por instancia (Clever Cloud permite 5 en total por usuario)
DB_CONNECTION_LIMIT=2

# Entorno
NODE_ENV=production
PORT=3000

# Para desarrollo local, copia este archivo a .env y llena con tus valores locales
